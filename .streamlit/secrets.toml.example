# Copy this file to .streamlit/secrets.toml and fill in the real values.
# secrets.toml is gitignored - it will never be committed. On Streamlit
# Community Cloud, paste this same [auth] block into the app's Settings ->
# Secrets box instead (the file itself never leaves your machine).
#
# Needed for Google sign-in (see auth.py) - requires a Google OAuth
# client. To create one:
#   1. https://console.cloud.google.com/ -> APIs & Services -> Credentials
#      -> Create Credentials -> OAuth client ID -> Application type "Web
#      application".
#   2. Authorized redirect URIs - add BOTH of these (one for local dev,
#      one for the deployed app at vocapp.streamlit.app):
#        http://localhost:8501/oauth2callback
#        https://vocapp.streamlit.app/oauth2callback
#   3. Copy the generated Client ID and Client secret into client_id /
#      client_secret below.
#
# IMPORTANT: redirect_uri below must match wherever THIS copy of the
# secrets is running - localhost for your local .streamlit/secrets.toml,
# but the real https://vocapp.streamlit.app/oauth2callback for the
# [auth] block you paste into Streamlit Cloud's Secrets box. Using the
# wrong one for that environment is the most common way this breaks.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"  # Cloud: "https://vocapp.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_STRING"
client_id = "REPLACE_WITH_GOOGLE_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
