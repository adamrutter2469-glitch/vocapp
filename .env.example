# Copy this file to .env and fill in your real values.
# .env is gitignored - it will never be committed.

ANTHROPIC_API_KEY=sk-ant-...
MW_DICTIONARY_KEY=...
MW_THESAURUS_KEY=...

# Cloudflare R2 (see r2_storage.py) - optional. Without these, the app
# just uses vocab.duckdb as a plain local file, same as always; with
# them, that file gets pulled from/pushed to the "vocapp" R2 bucket so
# data survives an ephemeral deploy (Streamlit Community Cloud) instead
# of living only on one machine's disk.
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
