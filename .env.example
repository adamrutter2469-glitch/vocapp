# Copy this file to .env and fill in your real values.
# .env is gitignored - it will never be committed.

ANTHROPIC_API_KEY=sk-ant-...
MW_DICTIONARY_KEY=...
MW_THESAURUS_KEY=...

# Postgres connection string (Neon: Project -> Connect -> use the
# "Pooled connection" string, which has -pooler in the host name).
# REQUIRED - the app has no local-file fallback anymore. On Streamlit
# Cloud, put the same value in the app's Secrets as DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 - no longer used for the database itself (that moved to
# Postgres); only needed for scripts/migrate_duckdb_to_postgres.py
# --from-r2 (pulling the last DuckDB copy), and later for backups.
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
